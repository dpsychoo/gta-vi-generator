---
import {
	LEGAL_PATHS,
	LEGAL_PROVIDER,
} from '../lib/legal';
---

<footer class="site-footer" aria-label="Información legal y de contacto">
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <strong>{LEGAL_PROVIDER.company}</strong>
      <span>RUT {LEGAL_PROVIDER.rut}</span>
      <a href={`mailto:${LEGAL_PROVIDER.supportEmail}`}>{LEGAL_PROVIDER.supportEmail}</a>
    </div>

    <nav class="site-footer__links" aria-label="Enlaces legales">
      <a href={LEGAL_PATHS.center}>Legal</a>
      <a href={LEGAL_PATHS.terms}>Términos</a>
      <a href={LEGAL_PATHS.privacy}>Privacidad</a>
      <a href={LEGAL_PATHS.refunds}>Reembolsos</a>
    </nav>

    <p class="site-footer__disclaimer">
      Esta experiencia es independiente. SGODX no está afiliado, patrocinado ni respaldado por Rockstar Games o Take-Two Interactive.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 10;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background:
      radial-gradient(circle at 18% 0%, rgba(255, 132, 178, 0.11), transparent 33%),
      linear-gradient(180deg, #10121b 0%, #080910 100%);
    color: var(--color-body);
    font-family: var(--font-body);
  }

  .site-footer__inner {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 28px;
    align-items: start;
    padding: 28px 0 30px;
    min-width: 0;
  }

  .site-footer__identity,
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    min-width: 0;
  }

  .site-footer__identity strong {
    color: var(--color-title);
    font-family: var(--font-display);
    letter-spacing: 0.05em;
    overflow-wrap: anywhere;
  }

  .site-footer__identity span,
  .site-footer__identity a,
  .site-footer__links a {
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-orange);
  }

  .site-footer a:focus-visible {
    outline: 2px solid #ffe29b;
    outline-offset: 4px;
    border-radius: 3px;
  }

  .site-footer__links {
    justify-content: flex-start;
  }

  .site-footer__links a {
    color: var(--color-link);
    font-weight: 700;
  }

  .site-footer__disclaimer {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      width: min(calc(100% - 24px), 560px);
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 24px 0 28px;
    }

    .site-footer__links {
      gap: 9px 18px;
    }
  }
</style>
