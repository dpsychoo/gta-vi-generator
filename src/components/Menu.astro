    <Image src={fondoMenu} alt="Menu Background" class="menu-background-image" loading="eager" />
  </div>  
  <div class="menu-right-side">
    <div class="menu-top-navigation">

<div class="menu-nav-tabs">

  <div class="menu-item active">
    Reserva el Juego
  </div>

  <a
    class="menu-item menu-social-link"
    href="https://www.instagram.com/sgodx_/"
    target="_blank"
    rel="noopener noreferrer"
  >
    Síguenos
  </a>

  <a
    class="menu-item menu-social-link"
    href="https://www.youtube.com/@SGODX_GTA"
    target="_blank"
    rel="noopener noreferrer"
  >
    YouTube
  </a>

  <div class="menu-item">
    PRÓXIMAMENTE
  </div>

</div>



