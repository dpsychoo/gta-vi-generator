---
import Layout from '../layouts/Layout.astro';
import {
	LEGAL_LAST_UPDATED,
	LEGAL_PATHS,
	LEGAL_PROVIDER,
	PRIVACY_VERSION,
	REFUND_POLICY_VERSION,
	TERMS_VERSION,
} from '../lib/legal';

const documents = [
  {
    href: LEGAL_PATHS.terms,
    label: 'Términos del Servicio',
    description: 'Condiciones de contratación, prestación del servicio digital, SGX PASS y eventos futuros.',
    version: TERMS_VERSION,
  },
  {
    href: LEGAL_PATHS.privacy,
    label: 'Política de Privacidad',
    description: 'Datos tratados, imágenes, proveedores, seguridad y conservación temporal.',
    version: PRIVACY_VERSION,
  },
  {
    href: LEGAL_PATHS.refunds,
    label: 'Retracto y Reembolsos',
    description: 'Inicio inmediato, exclusión informada del retracto y casos de soporte o restitución.',
    version: REFUND_POLICY_VERSION,
  },
];
---

<Layout title="Legal Center | SGODX" description="Centro legal de SGODX SpA.">
  <main class="legal-center-shell">
    <div class="legal-center-topbar">
      <a href="/">← Volver al generador</a>
    </div>

    <section class="legal-center-hero" aria-labelledby="legal-center-title">
      <p class="legal-center-kicker">SGODX / INFORMACIÓN LEGAL</p>
      <h1 id="legal-center-title">LEGAL CENTER</h1>
      <p>
        Información clara sobre el servicio digital personalizado, el tratamiento de datos y las condiciones aplicables a cada compra.
      </p>
      <div class="legal-center-meta">
        <span>{LEGAL_PROVIDER.company}</span>
        <span>RUT {LEGAL_PROVIDER.rut}</span>
        <span>Representante: {LEGAL_PROVIDER.representative}</span>
        <span>Versión vigente: {LEGAL_LAST_UPDATED}</span>
      </div>
    </section>

    <section aria-labelledby="legal-documents-title">
      <div class="legal-center-section-heading">
        <p class="legal-center-kicker">DOCUMENTOS</p>
        <h2 id="legal-documents-title">Consulta las condiciones</h2>
      </div>

      <div class="legal-center-grid">
        {documents.map((document) => (
          <a class="legal-center-document" href={document.href}>
            <span class="legal-center-document__label">{document.label}</span>
            <span class="legal-center-document__description">{document.description}</span>
            <span class="legal-center-document__version">Versión {document.version} →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="legal-center-contact" aria-labelledby="legal-contact-title">
      <p class="legal-center-kicker">CONTACTO</p>
      <h2 id="legal-contact-title">¿Necesitas ayuda?</h2>
      <p>
        Atención al cliente: <a href={`mailto:${LEGAL_PROVIDER.supportEmail}`}>{LEGAL_PROVIDER.supportEmail}</a>
      </p>
      <p>
        Asuntos legales: <a href={`mailto:${LEGAL_PROVIDER.legalEmail}`}>{LEGAL_PROVIDER.legalEmail}</a><br />
        Privacidad y datos personales: <a href={`mailto:${LEGAL_PROVIDER.privacyEmail}`}>{LEGAL_PROVIDER.privacyEmail}</a>
      </p>
    </section>
  </main>
</Layout>

<style>
  .legal-center-shell {
    width: 100%;
    min-height: 100vh;
    padding: clamp(24px, 4vw, 42px) clamp(12px, 4vw, 32px) clamp(48px, 7vw, 80px);
    background:
      radial-gradient(circle at 15% 0%, rgba(255, 116, 193, 0.13), transparent 34%),
      radial-gradient(circle at 88% 12%, rgba(117, 105, 255, 0.14), transparent 34%),
      #070910;
    color: var(--color-body);
    font-family: var(--font-body);
    overflow: clip;
  }

  .legal-center-topbar,
  .legal-center-hero,
  .legal-center-shell > section:not(.legal-center-hero) {
    width: min(900px, 100%);
    margin-inline: auto;
    min-width: 0;
  }

  .legal-center-topbar {
    margin-bottom: 20px;
  }

  .legal-center-topbar a,
  .legal-center-contact a {
    color: var(--color-link);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .legal-center-topbar a:hover,
  .legal-center-contact a:hover {
    color: var(--color-orange);
  }

  .legal-center-topbar a:focus-visible,
  .legal-center-contact a:focus-visible,
  .legal-center-document:focus-visible {
    outline: 2px solid #ffe29b;
    outline-offset: 4px;
    border-radius: 6px;
  }

  .legal-center-hero {
    padding: clamp(32px, 8vw, 74px) clamp(22px, 7vw, 72px);
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(20, 17, 39, 0.96), rgba(10, 12, 28, 0.98));
    box-shadow: 0 26px 80px rgba(0, 0, 0, 0.35), 0 0 42px rgba(232, 79, 178, 0.1);
  }

  .legal-center-kicker {
    margin: 0 0 12px;
    color: var(--color-pink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    line-height: 1.4;
  }

  .legal-center-hero h1 {
    margin: 0;
    color: var(--color-title);
    font-size: clamp(2.15rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.07em;
    overflow-wrap: anywhere;
  }

  .legal-center-hero > p:not(.legal-center-kicker) {
    max-width: 680px;
    margin: 22px 0 0;
    color: var(--color-body);
    font-size: clamp(0.95rem, 2.2vw, 1.12rem);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .legal-center-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 28px;
    color: var(--color-orange);
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .legal-center-section-heading {
    margin: 56px 0 18px;
  }

  .legal-center-section-heading h2,
  .legal-center-contact h2 {
    margin: 0;
    color: var(--color-title);
    font-size: clamp(1.45rem, 3.8vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }

  .legal-center-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .legal-center-document {
    display: flex;
    min-width: 0;
    min-height: 190px;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    padding: 22px;
    border: 1px solid rgba(255, 157, 211, 0.2);
    border-radius: 18px;
    background: rgba(10, 12, 28, 0.88);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.18);
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }

  .legal-center-document:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 217, 148, 0.62);
    background: rgba(25, 19, 45, 0.94);
  }

  .legal-center-document__label {
    color: var(--color-title);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .legal-center-document__description {
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .legal-center-document__version {
    color: var(--color-orange);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  .legal-center-contact {
    margin-top: 56px;
    padding: 24px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .legal-center-contact p:not(.legal-center-kicker) {
    margin: 10px 0 0;
    color: var(--color-body);
    font-size: 0.92rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .legal-center-shell {
      padding: 24px 12px 52px;
    }

    .legal-center-hero {
      padding: clamp(28px, 8vw, 44px) clamp(18px, 6vw, 32px);
      border-radius: 18px;
    }

    .legal-center-grid {
      grid-template-columns: 1fr;
    }

    .legal-center-document {
      min-height: 0;
    }
  }

  @media (max-width: 420px) {
    .legal-center-shell {
      padding-inline: 10px;
    }

    .legal-center-topbar {
      padding-inline: 2px;
    }

    .legal-center-hero {
      padding-inline: 16px;
    }

    .legal-center-meta {
      flex-direction: column;
      gap: 7px;
    }

    .legal-center-document {
      padding: 18px;
    }
  }
</style>
