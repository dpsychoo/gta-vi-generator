  .completed-intro h2 {
    margin: 18px 0 8px;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
    text-shadow: 0 3px 0 rgba(76, 32, 113, 0.66), 0 0 22px rgba(255, 114, 200, 0.28);
  }

  .completed-intro p {
    margin: 0;
    color: rgba(237, 242, 255, 0.72);
    font-size: clamp(0.9rem, 2.4vw, 1.08rem);
  }

  .completed-content .result-image-wrap {
