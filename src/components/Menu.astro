      target="_blank"
      rel="noopener noreferrer"
    >
      $10.000 DCTO CON MACHBANK
    </a>

  </div>

  <div class="game-cover-container">

    <a
      class="game-cover-link"
      href="https://meli.la/2Hc5QTw"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image
        src={gtaviPs5}
        alt="Grand Theft Auto VI para PlayStation 5"
        class="game-cover"
        loading="eager"
      />
    </a>

  </div>

</div>















