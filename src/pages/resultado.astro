---
import Layout from '../layouts/Layout.astro';
import resultFondo from '../assets/resultFondo.avif';
import '../styles/hero.css';

const { searchParams } = Astro.url;
const jobId = searchParams.get('jobId');
const accessToken = searchParams.get('token');
const isDev = import.meta.env.DEV;
---

<Layout>
  <main class="result-shell" data-runtime-env={isDev ? 'development' : 'production'} data-preview-pass-code={isDev ? 'SGX-DEMO-7K4M-92QH' : undefined} style={`--result-bg: url("${resultFondo.src}")`}>
    <div class="result-card">
      <div class="result-header">
        <span class="eyebrow">GTA VI</span>
        <h1>Resultado</h1>
      </div>

      <div class="result-status" id="statusPanel">
        {jobId && accessToken ? 'Revisando tu pedido...' : 'Resultado no disponible'}
      </div>

      <section class="generation-loader" id="generationLoader" hidden aria-live="polite" aria-busy="true">
        <div class="generation-loader__wash" aria-hidden="true"></div>
        <div class="generation-loader__scanlines" aria-hidden="true"></div>
        <div class="generation-loader__particles" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="generation-loader__content">
          <div class="generation-loader__vi" aria-hidden="true">VI</div>
          <div class="generation-loader__kicker">SGODX / VICE CITY LABS</div>
          <h2>GENERANDO TU IMAGEN</h2>
          <p class="generation-loader__subtitle">Estamos preparando tu experiencia...</p>

          <div
            class="generation-loader__progress"
            id="generationProgress"
            role="progressbar"
            aria-label="Progreso visual de generación"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-valuetext="Progreso visual, sin tiempo restante estimado"
          >
            <div class="generation-loader__progress-track">
              <div class="generation-loader__progress-bar" id="generationProgressBar"></div>
            </div>
            <div class="generation-loader__progress-meta">
              <span id="generationProgressValue">0%</span>
              <span>LIVE RENDER</span>
            </div>
          </div>

          <p class="generation-loader__stage" id="generationStage" role="status" aria-live="polite">
            Analizando tus fotografías...
          </p>

          <div class="generation-loader__email-note">
            <span class="generation-loader__email-icon" aria-hidden="true">✦</span>
            <div>
              <strong>Tu resultado también llegará a tu email</strong>
              <span>Puedes cerrar esta pestaña si quieres. Te enviaremos un enlace para ver y descargar tu imagen cuando esté lista.</span>
            </div>
          </div>
        </div>
      </section>

      <section class="completed-content" id="completedContent" hidden aria-live="polite">
        <div class="completed-intro">
          <div class="completed-badge"><span aria-hidden="true">✓</span> IMAGEN LISTA</div>
          <h2>TU RESULTADO ESTÁ LISTO</h2>
          <p>Tu imagen se generó correctamente.</p>
        </div>

      <div class="result-image-wrap" id="imageWrap" hidden>
        <img id="resultImage" alt="Imagen generada" />
        <div class="preview-image" id="previewImage" hidden role="img" aria-label="Imagen generada de preview">
          <span>SGODX</span>
          <strong>VI</strong>
          <small>VICE CITY PORTRAIT / DEMO RENDER</small>
        </div>
      </div>

      <div class="result-actions">
        <button id="downloadBtn" class="download-btn" type="button" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v2h14v-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg>
          <span>DESCARGAR IMAGEN</span>
        </button>
      </div>

      <section class="sgx-pass-panel" id="sgxPassPanel" hidden aria-live="polite">
        <div class="sgx-pass-heading">
          <div class="sgx-pass-eyebrow">SGX · VI PASS</div>
          <p class="sgx-pass-subtitle">TU IDENTIDAD EN SGODX</p>
        </div>
        <div class="sgx-pass-code-shell">
          <div class="sgx-pass-code" id="sgxPassCode"></div>
          <button id="copySgxPassBtn" class="sgx-pass-copy" type="button" hidden>COPIAR</button>
          <span id="copySgxPassFeedback" class="sgx-pass-copy-feedback" role="status" aria-live="polite"></span>
        </div>
        <div class="sgx-pass-grid">
          <div>
            <span class="sgx-pass-label">MEMBERSHIP</span>
            <strong class="sgx-pass-value" id="sgxPassMembership">PERMANENT</strong>
          </div>
          <div>
            <span class="sgx-pass-label">PASS STATUS</span>
            <strong class="sgx-pass-value" id="sgxPassStatus"></strong>
          </div>
        </div>
        <div class="sgx-purchase-panel sgxvi-purchase" id="sgxPurchasePanel" hidden>
          <span class="sgx-pass-label">PURCHASE NUMBER</span>
          <div class="sgxvi-purchase__value">
            <span class="sgxvi-purchase__label" id="sgxPurchaseLabel"></span>
            <strong class="sgxvi-purchase__number" id="sgxPurchaseNumber"></strong>
          </div>
          <p class="sgx-purchase-note">Tu número de compra dentro de SGX · VI.</p>
          <div class="sgxvi-milestone-unlocked" id="sgxMilestoneUnlocked" hidden>
            <span class="sgxvi-milestone-unlocked__label">MILESTONE UNLOCKED</span>
          </div>
          <div class="sgxvi-purchase-history" id="sgxPurchaseHistory" hidden>
            <span class="sgx-pass-label">PURCHASE HISTORY</span>
            <div class="sgxvi-purchase-history__list" id="sgxPurchaseHistoryList" role="list"></div>
          </div>
          <div class="sgxvi-milestone-panel" id="sgxMilestonePanel" hidden>
            <span class="sgx-pass-label">NEXT MILESTONE</span>
            <strong class="sgxvi-milestone-panel__number" id="sgxMilestoneNumber"></strong>
            <div class="sgxvi-milestone-panel__progress" id="sgxMilestoneProgress" role="progressbar" aria-label="Milestone progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="sgxvi-milestone-panel__progress-bar" id="sgxMilestoneProgressBar"></div>
            </div>
            <div class="sgxvi-milestone-panel__meta">
              <span id="sgxMilestoneProgressValue">0%</span>
              <span><span id="sgxMilestoneRemaining">0</span> PURCHASES TO GO</span>
            </div>
          </div>
        </div>
        <p class="sgx-pass-note"><strong>Guarda tu SGX · VI PASS.</strong> Será tu código dentro del ecosistema SGODX.</p>
      </section>

        <div class="completed-email-note">
          <span class="completed-email-icon" aria-hidden="true">✦</span>
          <div>
            <strong>Tu resultado también llegará a tu email</strong>
            <span>Puedes cerrar esta pestaña si quieres. Te enviaremos un enlace para volver a tu resultado.</span>
          </div>
        </div>

        <div class="completed-powered">POWERED BY <span>SGODX</span></div>
      </section>
    </div>
  </main>

  <script is:inline>
    const queryJobId = new URLSearchParams(window.location.search).get('jobId');
    const queryAccessToken = new URLSearchParams(window.location.search).get('token');
    const resultShell = document.querySelector('.result-shell');
    const runtimeIsDev = resultShell?.dataset.runtimeEnv === 'development';
    const devPreviewPassCode = resultShell?.dataset.previewPassCode || '';
    const previewLoaderEnabled = runtimeIsDev && new URLSearchParams(window.location.search).get('previewLoader') === '1';
    const previewLoaderComplete = previewLoaderEnabled && new URLSearchParams(window.location.search).get('previewComplete') === '1';
    const statusPanel = document.getElementById('statusPanel');
    const generationLoader = document.getElementById('generationLoader');
    const generationProgress = document.getElementById('generationProgress');
    const generationProgressBar = document.getElementById('generationProgressBar');
    const generationProgressValue = document.getElementById('generationProgressValue');
    const generationStage = document.getElementById('generationStage');
    const completedContent = document.getElementById('completedContent');
    const imageWrap = document.getElementById('imageWrap');
    const imageEl = document.getElementById('resultImage');
    const previewImage = document.getElementById('previewImage');
    const downloadBtn = document.getElementById('downloadBtn');
    const sgxPassPanel = document.getElementById('sgxPassPanel');
    const sgxPassCode = document.getElementById('sgxPassCode');
    const sgxPassMembership = document.getElementById('sgxPassMembership');
    const sgxPassStatus = document.getElementById('sgxPassStatus');
    const sgxPurchasePanel = document.getElementById('sgxPurchasePanel');
    const sgxPurchaseLabel = document.getElementById('sgxPurchaseLabel');
    const sgxPurchaseNumber = document.getElementById('sgxPurchaseNumber');
    const sgxMilestoneUnlocked = document.getElementById('sgxMilestoneUnlocked');
    const sgxPurchaseHistory = document.getElementById('sgxPurchaseHistory');
    const sgxPurchaseHistoryList = document.getElementById('sgxPurchaseHistoryList');
    const sgxMilestonePanel = document.getElementById('sgxMilestonePanel');
    const sgxMilestoneNumber = document.getElementById('sgxMilestoneNumber');
    const sgxMilestoneProgress = document.getElementById('sgxMilestoneProgress');
    const sgxMilestoneProgressBar = document.getElementById('sgxMilestoneProgressBar');
    const sgxMilestoneProgressValue = document.getElementById('sgxMilestoneProgressValue');
    const sgxMilestoneRemaining = document.getElementById('sgxMilestoneRemaining');
    const copySgxPassBtn = document.getElementById('copySgxPassBtn');
    const copySgxPassFeedback = document.getElementById('copySgxPassFeedback');

    const statusLabels = {
      pending_payment: 'Pendiente de pago',
      paid: 'Pago confirmado',
      processing: 'Creando tu imagen...',
      completed: 'Imagen lista',
      failed: 'No pudimos generar tu imagen'
    };

    const knownStatuses = ['pending_payment', 'paid', 'processing', 'completed', 'failed', 'error', 'unknown'];
    let pollingTimer = null;
    let pollingStopped = false;
    let requestInFlight = false;
    let visualProgressTimer = null;
    let stageMessagesTimer = null;
    let loaderExitTimer = null;
    let copyFeedbackTimer = null;
    let visualProgressValue = 0;
    let stageMessageIndex = 0;
    let generationLoaderVisible = false;

    const generationStageMessages = [
      'Analizando tus fotografías...',
      'Construyendo tu identidad en Vice City...',
      'Ajustando luces, color y actitud...',
      'Aplicando el look SGODX...',
      'Dando los últimos detalles al render...'
    ];

    function setStatus(status, text) {
      statusPanel.classList.remove(...knownStatuses.map((name) => `status-${name}`));
      statusPanel.classList.add(`status-${status}`);
      statusPanel.dataset.status = status;
      statusPanel.textContent = text;
    }

    function showCompletedContent() {
      completedContent.hidden = false;
      statusPanel.hidden = true;
    }

    function hideCompletedContent() {
      completedContent.hidden = true;
      statusPanel.hidden = false;
    }

    function setVisualProgress(value) {
      visualProgressValue = Math.max(0, Math.min(100, value));
      const roundedValue = Math.round(visualProgressValue);

      if (generationProgressBar) {
        generationProgressBar.style.width = `${visualProgressValue}%`;
      }
      if (generationProgressValue) {
        generationProgressValue.textContent = `${roundedValue}%`;
      }
      if (generationProgress) {
        generationProgress.setAttribute('aria-valuenow', String(roundedValue));
      }
    }

    function stopVisualProgress() {
      if (visualProgressTimer !== null) {
        window.clearTimeout(visualProgressTimer);
        visualProgressTimer = null;
      }
    }

    function startVisualProgress() {
      if (!generationLoader || visualProgressTimer !== null || visualProgressValue >= 93) return;

      const tick = () => {
        visualProgressTimer = null;
        if (!generationLoaderVisible || visualProgressValue >= 93) return;

        const isFast = visualProgressValue < 18;
        const isMedium = visualProgressValue < 45;
        const delta = isFast ? 2.8 : isMedium ? 1.4 : visualProgressValue < 70 ? 0.75 : visualProgressValue < 85 ? 0.35 : 0.12;
        const delay = isFast ? 80 : isMedium ? 130 : visualProgressValue < 70 ? 180 : 260;

        setVisualProgress(Math.min(93, visualProgressValue + delta));
        visualProgressTimer = window.setTimeout(tick, delay);
      };

      tick();
    }

    function stopStageMessages() {
      if (stageMessagesTimer !== null) {
        window.clearInterval(stageMessagesTimer);
        stageMessagesTimer = null;
      }
    }

    function startStageMessages() {
      if (!generationStage || stageMessagesTimer !== null) return;

      stageMessageIndex = 0;
      generationStage.textContent = generationStageMessages[stageMessageIndex];
      stageMessagesTimer = window.setInterval(() => {
        stageMessageIndex = (stageMessageIndex + 1) % generationStageMessages.length;
        generationStage.classList.remove('is-changing');
        void generationStage.offsetWidth;
        generationStage.textContent = generationStageMessages[stageMessageIndex];
        generationStage.classList.add('is-changing');
      }, 2800);
    }

    function showGenerationLoader() {
      if (!generationLoader) return;

      if (loaderExitTimer !== null) {
        window.clearTimeout(loaderExitTimer);
        loaderExitTimer = null;
        setVisualProgress(0);
      }

      generationLoaderVisible = true;
      generationLoader.hidden = false;
      generationLoader.classList.remove('is-leaving');
      generationLoader.setAttribute('aria-busy', 'true');
      statusPanel.hidden = true;
      startVisualProgress();
      startStageMessages();
    }

    function hideGenerationLoader() {
      stopVisualProgress();
      stopStageMessages();
      if (loaderExitTimer !== null) {
        window.clearTimeout(loaderExitTimer);
        loaderExitTimer = null;
      }

      generationLoaderVisible = false;
      if (generationLoader) {
        generationLoader.hidden = true;
        generationLoader.classList.remove('is-leaving');
        generationLoader.setAttribute('aria-busy', 'false');
      }
      statusPanel.hidden = false;
      setVisualProgress(0);
    }

    function completeVisualProgress(onComplete) {
      if (loaderExitTimer !== null) return;

      if (!generationLoader || generationLoader.hidden || !generationLoaderVisible) {
        statusPanel.hidden = false;
        onComplete();
        return;
      }

      stopVisualProgress();
      stopStageMessages();
      generationLoaderVisible = false;
      setVisualProgress(100);
      generationLoader.classList.add('is-leaving');

      loaderExitTimer = window.setTimeout(() => {
        loaderExitTimer = null;
        generationLoader.hidden = true;
        generationLoader.classList.remove('is-leaving');
        generationLoader.setAttribute('aria-busy', 'false');
        statusPanel.hidden = false;
        setVisualProgress(0);
        onComplete();
      }, 550);
    }

    function clearGenerationTimers() {
      stopVisualProgress();
      stopStageMessages();
      if (loaderExitTimer !== null) {
        window.clearTimeout(loaderExitTimer);
        loaderExitTimer = null;
      }
      if (copyFeedbackTimer !== null) {
        window.clearTimeout(copyFeedbackTimer);
        copyFeedbackTimer = null;
      }
    }

    function hideResult() {
      imageWrap.hidden = true;
      downloadBtn.hidden = true;
      imageEl.hidden = true;
      previewImage.hidden = true;
      imageEl.removeAttribute('src');
      imageEl.onload = null;
      imageEl.onerror = null;
      downloadBtn.onclick = null;
    }

    function hideSgxPass() {
      if (copyFeedbackTimer !== null) {
        window.clearTimeout(copyFeedbackTimer);
        copyFeedbackTimer = null;
      }
      sgxPassPanel.hidden = true;
      sgxPassCode.textContent = '';
      sgxPassMembership.textContent = '';
      sgxPassStatus.textContent = '';
      sgxPurchasePanel.hidden = true;
      sgxPurchaseLabel.textContent = '';
      sgxPurchaseNumber.textContent = '';
      resetPurchaseExperience();
      copySgxPassBtn.hidden = true;
      copySgxPassFeedback.textContent = '';
    }

    function formatSgxviPurchaseNumber(purchaseNumber) {
      if (purchaseNumber === null || purchaseNumber === undefined) return '';
      const normalized = String(purchaseNumber).trim();
      return /^[1-9][0-9]*$/.test(normalized)
        ? `SGXVI PURCHASE #${normalized.padStart(6, '0')}`
        : '';
    }

    function splitSgxviPurchaseNumber(purchaseLabel) {
      if (!purchaseLabel) return null;
      const separatorIndex = purchaseLabel.lastIndexOf(' #');
      if (separatorIndex <= 0) return null;

      const label = purchaseLabel.slice(0, separatorIndex);
      const number = purchaseLabel.slice(separatorIndex + 1);
      return label && /^#[0-9]+$/.test(number) ? { label, number } : null;
    }

    function normalizePublicPurchaseNumber(value) {
      const normalized = String(value ?? '').trim();
      return /^[1-9][0-9]*$/.test(normalized) ? normalized : '';
    }

    function formatPublicPurchaseNumber(value) {
      const normalized = normalizePublicPurchaseNumber(value);
      return normalized ? `#${normalized.padStart(6, '0')}` : '';
    }

    function resetPurchaseExperience() {
      sgxPurchaseNumber.classList.remove('is-milestone');
      sgxMilestoneUnlocked.hidden = true;
      sgxPurchaseHistory.hidden = true;
      sgxPurchaseHistoryList.replaceChildren();
      sgxMilestonePanel.hidden = true;
      sgxMilestoneNumber.textContent = '';
      sgxMilestoneProgressBar.style.width = '0%';
      sgxMilestoneProgressValue.textContent = '0%';
      sgxMilestoneRemaining.textContent = '0';
      sgxMilestoneProgress.setAttribute('aria-valuenow', '0');
    }

    function renderPurchaseHistory(history) {
      const items = Array.isArray(history) ? history : [];
      const fragment = document.createDocumentFragment();
      let renderedItems = 0;

      for (const item of items) {
        const displayNumber = formatPublicPurchaseNumber(item?.purchase_number);
        if (!displayNumber) continue;

        const historyItem = document.createElement('span');
        historyItem.className = `sgxvi-purchase-history__item${item?.is_current === true ? ' is-current' : ''}`;
        historyItem.setAttribute('role', 'listitem');

        const number = document.createElement('span');
        number.textContent = displayNumber;
        historyItem.append(number);

        if (item?.is_current === true) {
          const current = document.createElement('small');
          current.textContent = 'CURRENT';
          historyItem.append(current);
        }

        fragment.append(historyItem);
        renderedItems += 1;
      }

      sgxPurchaseHistoryList.replaceChildren(fragment);
      sgxPurchaseHistory.hidden = renderedItems === 0;
    }

    function renderMilestoneExperience(purchaseNumber, nextMilestone, currentMilestone, progress) {
      const currentNumber = normalizePublicPurchaseNumber(purchaseNumber);
      const unlockedNumber = normalizePublicPurchaseNumber(currentMilestone?.purchase_number);
      const isMilestoneUnlocked = Boolean(
        currentNumber
        && unlockedNumber
        && currentNumber === unlockedNumber
        && currentMilestone?.reached === true,
      );

      sgxPurchaseNumber.classList.toggle('is-milestone', isMilestoneUnlocked);
      sgxMilestoneUnlocked.hidden = !isMilestoneUnlocked;

      const nextNumber = normalizePublicPurchaseNumber(nextMilestone?.purchase_number);
      const percentage = Number(progress?.percentage);
      const remaining = normalizePublicPurchaseNumber(progress?.remaining || '');
      if (!nextNumber || !Number.isFinite(percentage) || !remaining) {
        sgxMilestonePanel.hidden = true;
        return;
      }

      const boundedPercentage = Math.max(0, Math.min(100, Math.round(percentage)));
      sgxMilestoneNumber.textContent = formatPublicPurchaseNumber(nextNumber);
      sgxMilestoneProgressBar.style.width = `${boundedPercentage}%`;
      sgxMilestoneProgressValue.textContent = `${boundedPercentage}%`;
      sgxMilestoneRemaining.textContent = remaining;
      sgxMilestoneProgress.setAttribute('aria-valuenow', String(boundedPercentage));
      sgxMilestonePanel.hidden = false;
    }

    function showSgxPass(pass, purchaseNumber, purchaseHistory, nextMilestone, currentMilestone, milestoneProgress) {
      const code = typeof pass?.code === 'string' ? pass.code : '';
      const status = ['active', 'suspended', 'revoked'].includes(pass?.status) ? pass.status : '';
      const purchaseLabel = splitSgxviPurchaseNumber(formatSgxviPurchaseNumber(purchaseNumber));
      if (!code && !purchaseLabel) {
        hideSgxPass();
        return;
      }

      const hasPass = Boolean(code && status);
      sgxPassCode.textContent = hasPass ? code : '';
      sgxPassMembership.textContent = hasPass ? 'PERMANENT' : '';
      sgxPassStatus.textContent = hasPass ? `● ${status.toUpperCase()}` : '';
      copySgxPassBtn.hidden = !hasPass;
      copySgxPassFeedback.textContent = '';
      sgxPurchaseLabel.textContent = purchaseLabel?.label || '';
      sgxPurchaseNumber.textContent = purchaseLabel?.number || '';
      sgxPurchasePanel.hidden = !purchaseLabel;
      resetPurchaseExperience();
      renderPurchaseHistory(purchaseHistory);
      renderMilestoneExperience(purchaseNumber, nextMilestone, currentMilestone, milestoneProgress);
      sgxPassPanel.hidden = false;
    }

    async function copySgxPass() {
      const passCode = sgxPassCode.textContent.trim();
      if (!passCode) return;

      if (copyFeedbackTimer !== null) {
        window.clearTimeout(copyFeedbackTimer);
      }

      try {
        await navigator.clipboard.writeText(passCode);
        copySgxPassFeedback.textContent = 'COPIADO ✓';
      } catch {
        copySgxPassFeedback.textContent = 'NO SE PUDO COPIAR';
      }

      copyFeedbackTimer = window.setTimeout(() => {
        copySgxPassFeedback.textContent = '';
        copyFeedbackTimer = null;
      }, 1800);
    }

    copySgxPassBtn.addEventListener('click', copySgxPass);

    function stopPolling() {
      pollingStopped = true;
      if (pollingTimer !== null) {
        window.clearTimeout(pollingTimer);
        pollingTimer = null;
      }
    }

    function schedulePolling() {
      if (pollingStopped || pollingTimer !== null) return;
      pollingTimer = window.setTimeout(() => {
        pollingTimer = null;
        poll();
      }, 2500);
    }

    function showCompletedResult() {
      if (!queryJobId || !queryAccessToken) return;

      const imageUrl = `/api/image?jobId=${encodeURIComponent(queryJobId)}&token=${encodeURIComponent(queryAccessToken)}`;
      imageWrap.hidden = true;
      downloadBtn.hidden = true;
      imageEl.hidden = false;
      previewImage.hidden = true;

      imageEl.onload = () => {
        imageWrap.hidden = false;
        downloadBtn.hidden = false;
      };

      imageEl.onerror = () => {
        imageWrap.hidden = true;
        downloadBtn.hidden = true;
        setStatus('completed', 'Imagen lista, pero la vista previa no está disponible');
      };

      imageEl.src = imageUrl;
      downloadBtn.onclick = () => {
        const link = document.createElement('a');
        link.href = imageUrl;
        link.download = 'gta-vi-result.png';
        document.body.appendChild(link);
        link.click();
        link.remove();
      };
    }

    function showPreviewCompletedResult() {
      hideResult();
      imageEl.hidden = true;
      previewImage.hidden = false;
      imageWrap.hidden = false;
      downloadBtn.hidden = false;
      downloadBtn.onclick = () => {};
    }

    function applyJobState(job) {
      const status = typeof job?.status === 'string' ? job.status : 'unknown';
      const label = statusLabels[status] || 'Revisando tu pedido...';
      setStatus(status, label);

      if (status === 'completed') {
        stopPolling();
        completeVisualProgress(() => {
          showCompletedContent();
          showSgxPass(
            job.sgxPass,
            job.purchase_number,
            job.purchase_history,
            job.next_milestone,
            job.current_milestone,
            job.milestone_progress,
          );
          showCompletedResult();
        });
        return;
      }

      if (status === 'failed') {
        stopPolling();
        hideGenerationLoader();
        hideCompletedContent();
        hideSgxPass();
        hideResult();
        return;
      }

      if (status === 'processing') {
        hideCompletedContent();
        hideSgxPass();
        hideResult();
        showGenerationLoader();
        schedulePolling();
        return;
      }

      hideGenerationLoader();
      hideCompletedContent();
      hideSgxPass();
      hideResult();
      schedulePolling();
    }

    async function poll() {
      if (!queryJobId || !queryAccessToken || pollingStopped || requestInFlight) return;

      requestInFlight = true;

      try {
        const res = await fetch(`/api/job-status?jobId=${encodeURIComponent(queryJobId)}&token=${encodeURIComponent(queryAccessToken)}`);
        if (!res.ok) {
          throw new Error('No se pudo consultar el job');
        }

        const job = await res.json();
        applyJobState(job);
      } catch {
        setStatus('error', 'No pudimos consultar el estado de tu pedido');
        schedulePolling();
      } finally {
        requestInFlight = false;
      }
    }

    if (previewLoaderEnabled) {
      setStatus('processing', 'Preview del loader');
      showGenerationLoader();

      if (previewLoaderComplete) {
        setVisualProgress(93);
        completeVisualProgress(() => {
          showCompletedContent();
          showPreviewCompletedResult();
          showSgxPass({ code: devPreviewPassCode, status: 'active' });
        });
      }
    } else if (queryJobId && queryAccessToken) {
      poll();
    }

    window.addEventListener('pagehide', clearGenerationTimers, { once: true });
  </script>
</Layout>

<style>
  :root {
    --bg: #05070d;
    --panel: rgba(15, 18, 24, 0.88);
    --panel-border: rgba(255,255,255,0.12);
    --text: #edf2ff;
    --muted: #aab7d0;
    --accent: #f7c65c;
    --accent-2: #ff6b6b;
  }

  html, body {
    margin: 0;
    min-height: 100%;
    background: radial-gradient(circle at top, #171c24 0%, #05070d 55%, #020407 100%);
    color: var(--text);
    font-family: 'Poppins', sans-serif;
  }

  .result-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 80px 20px;
  }

  .result-card {
    width: min(720px, 100%);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    box-shadow: 0 20px 80px rgba(0,0,0,.45);
    border-radius: 28px;
    padding: 28px;
  }

  .result-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 16px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 20px;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 3vw, 2.8rem);
  }

  .result-status {
    color: var(--muted);
    font-size: 1.05rem;
    margin-bottom: 22px;
  }

  .result-image-wrap {
    margin-top: 18px;
    background: #0a0d12;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }

  #resultImage {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    background: #080b10;
  }

  .result-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 22px;
  }

  .download-btn {
    background: linear-gradient(135deg, #d63ca3 0%, #f7665c 0%, #632bff 100%);
    color: #ffffff;
    border: none;
    border-radius: 999px;
    padding: 0.9rem 1.5rem;
    font-weight: 800;
    cursor: pointer;

    
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    -webkit-text-stroke: 0.25px #0c0455;
    text-transform: uppercase;
    text-shadow:
        -2px 0 2px rgba(80, 180, 255, 0.65),
         2px 0 2px rgba(255, 150, 80, 0.45),
         0 0 8px rgba(255, 255, 255, 0.15);
         transition: 
        transform 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;

  }

  .sgx-pass-panel {
    margin-top: 28px;
    padding: 24px;
    border: 1px solid rgba(255, 116, 188, 0.38);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(49, 21, 58, 0.94), rgba(17, 16, 29, 0.96));
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.24);
  }

  .sgx-pass-eyebrow {
    color: #ff9ecb;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sgx-pass-code {
    margin-top: 12px;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(1.35rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    overflow-wrap: anywhere;
  }

  .sgx-pass-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 22px;
  }

  .sgx-purchase-panel {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 116, 188, 0.2);
  }

  .sgxvi-purchase__value {
    display: block;
    min-width: 0;
    max-width: 100%;
    margin-top: 5px;
  }

  .sgxvi-purchase__label {
    display: block;
    color: #ffe0a1;
    font-size: clamp(1rem, 3vw, 1.25rem);
    letter-spacing: 0.08em;
    line-height: 1;
    overflow-wrap: anywhere;
    font-family: inherit;
    font-weight: 400;
  }

  .sgxvi-purchase__number {
    display: block;
    margin-top: 0.35rem;
    max-width: 100%;
    font-family: "GTA_PRICE_FONT", sans-serif;
    font-weight: 400;
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: #55ff3f;
    overflow-wrap: anywhere;
    -webkit-text-stroke: 2px #000;
    paint-order: stroke fill;
    text-shadow:
      2px 0 0 #000,
      -2px 0 0 #000,
      0 2px 0 #000,
      0 -2px 0 #000,
      2px 2px 0 #000,
      -2px 2px 0 #000,
      2px -2px 0 #000,
      -2px -2px 0 #000;
  }

  .sgx-purchase-note {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .sgxvi-milestone-unlocked {
    margin-top: 18px;
  }

  .sgxvi-milestone-unlocked__label {
    color: #ffe37c;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sgxvi-purchase-history {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sgxvi-purchase-history__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 8px;
    min-width: 0;
  }

  .sgxvi-purchase-history__item {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    max-width: 100%;
    color: #e2e6ef;
    font-family: "GTA_PRICE_FONT", sans-serif;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .sgxvi-purchase-history__item.is-current {
    color: #55ff3f;
  }

  .sgxvi-purchase-history__item small {
    color: currentColor;
    font-family: inherit;
    font-size: 0.45em;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .sgxvi-milestone-panel {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 227, 124, 0.2);
  }

  .sgxvi-milestone-panel__number {
    display: block;
    margin-top: 7px;
    color: #ffe37c;
    font-family: "GTA_PRICE_FONT", sans-serif;
    font-size: clamp(1.2rem, 3.5vw, 1.75rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .sgxvi-milestone-panel__progress {
    height: 8px;
    margin-top: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 227, 124, 0.42);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }

  .sgxvi-milestone-panel__progress-bar {
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #55ff3f, #ffe37c);
    transition: width 240ms ease;
  }

  .sgxvi-milestone-panel__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 7px;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sgxvi-purchase__number.is-milestone {
    position: relative;
    color: #ffd84d;
    background: linear-gradient(
      180deg,
      #fff7b0 0%,
      #ffd84d 25%,
      #f2a900 60%,
      #fff0a0 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sgxvi-purchase__number.is-milestone::before,
  .sgxvi-purchase__number.is-milestone::after {
    position: absolute;
    color: #fff7b0;
    content: '✦';
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.42em;
    line-height: 1;
    pointer-events: none;
    -webkit-text-fill-color: #fff7b0;
    -webkit-text-stroke: 0;
    text-shadow: none;
    animation: sgxvi-purchase-sparkle 1.8s ease-in-out infinite;
  }

  .sgxvi-purchase__number.is-milestone::before {
    top: -0.15em;
    right: 0.1em;
  }

  .sgxvi-purchase__number.is-milestone::after {
    bottom: -0.2em;
    left: 0.1em;
    animation-delay: 0.55s;
  }

  @keyframes sgxvi-purchase-sparkle {
    0%, 100% {
      opacity: 0.45;
      transform: scale(0.72) rotate(0deg);
    }
    50% {
      opacity: 1;
      transform: scale(1.08) rotate(18deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sgxvi-purchase__number.is-milestone::before,
    .sgxvi-purchase__number.is-milestone::after,
    .sgxvi-milestone-panel__progress-bar {
      animation: none;
      transition: none;
    }
  }

  .sgx-pass-label {
    display: block;
    color: #9f94b3;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sgx-pass-value {
    display: block;
    margin-top: 5px;
    color: #ffc0dd;
    font-size: 0.92rem;
    letter-spacing: 0.08em;
  }

  .sgx-pass-note {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .sgx-pass-motto {
    margin: 14px 0 0;
    color: #ff9d69;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  @media (max-width: 560px) {
    .sgx-pass-panel {
      padding: 20px;
    }

    .sgx-pass-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }





.result-shell {
  min-height: 100vh;
  position: relative;

  background-image:
    linear-gradient(
      rgba(0, 0, 0, 0.35),
      rgba(0, 0, 0, 0.35)
    ),
    var(--result-bg);

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  align-items: center;
  justify-content: center;
}



  
  .result-shell {
    min-height: 100dvh;
  }

  .result-card {
    position: relative;
    overflow: hidden;
  }

  .generation-loader[hidden] {
    display: none;
  }

  .generation-loader {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(560px, 78dvh, 820px);
    min-height: clamp(560px, 78dvh, calc(100dvh - 48px));
    place-items: center;
    overflow: hidden;
    padding: calc(clamp(48px, 8vw, 88px) + env(safe-area-inset-top)) clamp(20px, 6vw, 64px) calc(clamp(48px, 8vw, 88px) + env(safe-area-inset-bottom));
    border: 1px solid rgba(255, 155, 211, 0.34);
    border-radius: 24px;
    background:
      radial-gradient(circle at 18% 18%, rgba(255, 95, 194, 0.32), transparent 34%),
      radial-gradient(circle at 88% 20%, rgba(255, 174, 73, 0.24), transparent 30%),
      radial-gradient(circle at 50% 110%, rgba(83, 75, 255, 0.38), transparent 52%),
      #100b24;
    box-shadow: inset 0 0 60px rgba(17, 8, 39, 0.82), 0 18px 50px rgba(7, 3, 23, 0.36);
    color: #ffffff;
  }

  .generation-loader__wash,
  .generation-loader__scanlines,
  .generation-loader__particles,
  .generation-loader__vi {
    position: absolute;
    pointer-events: none;
  }

  .generation-loader__wash {
    inset: -20%;
    z-index: -3;
    background: conic-gradient(from 120deg at 50% 50%, rgba(255, 80, 196, 0.16), rgba(255, 184, 80, 0.13), rgba(69, 74, 255, 0.2), rgba(255, 80, 196, 0.16));
    filter: blur(28px);
    animation: generationAmbientShift 15s ease-in-out infinite alternate;
  }

  .generation-loader__scanlines {
    inset: 0;
    z-index: -1;
    opacity: 0.17;
    background: repeating-linear-gradient(0deg, transparent 0 4px, rgba(255, 255, 255, 0.08) 5px, transparent 6px 9px);
    mix-blend-mode: screen;
  }

  .generation-loader__vi {
    inset: 50% auto auto 50%;
    z-index: -2;
    color: transparent;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(12rem, 36vw, 25rem);
    font-weight: 900;
    letter-spacing: -0.15em;
    line-height: 0.72;
    opacity: 0.16;
    text-indent: -0.15em;
    transform: translate(-50%, -50%) rotate(-8deg);
    -webkit-text-stroke: clamp(2px, 0.45vw, 6px) rgba(255, 186, 223, 0.72);
    text-shadow: 0 0 32px rgba(255, 100, 198, 0.54), 0 0 90px rgba(107, 92, 255, 0.52);
    animation: generationViPulse 6s ease-in-out infinite;
    user-select: none;
  }

  .generation-loader__content {
    position: relative;
    z-index: 2;
    width: min(100%, 610px);
    text-align: center;
  }

  .generation-loader__kicker {
    color: #ffb5db;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(0.68rem, 1.8vw, 0.82rem);
    font-weight: 800;
    letter-spacing: 0.22em;
    text-shadow: 0 0 18px rgba(255, 124, 207, 0.72);
  }

  .generation-loader h2 {
    margin: 18px 0 8px;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(2rem, 6vw, 4.25rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-shadow: 0 3px 0 rgba(89, 34, 122, 0.8), 0 0 28px rgba(255, 107, 197, 0.45);
  }

  .generation-loader__subtitle {
    margin: 0;
    color: rgba(255, 238, 250, 0.78);
    font-size: clamp(0.9rem, 2.5vw, 1.08rem);
  }

  .generation-loader__progress {
    width: min(100%, 520px);
    margin: clamp(28px, 5vw, 42px) auto 0;
  }

  .generation-loader__progress-track {
    position: relative;
    height: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(15, 7, 31, 0.74);
    box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.34), 0 0 20px rgba(255, 101, 199, 0.2);
  }

  .generation-loader__progress-bar {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #ff63bd 0%, #ffab68 46%, #ffe087 100%);
    box-shadow: 0 0 18px rgba(255, 128, 194, 0.92), 0 0 34px rgba(255, 178, 95, 0.48);
    transition: width 180ms linear;
  }

  .generation-loader__progress-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 10px;
    color: rgba(255, 236, 248, 0.76);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .generation-loader__progress-meta span:first-child {
    color: #ffe39e;
  }

  .generation-loader__stage {
    min-height: 1.8em;
    margin: 24px 0 0;
    color: #ffffff;
    font-size: clamp(0.9rem, 2.4vw, 1.06rem);
    font-weight: 600;
    text-shadow: 0 0 16px rgba(255, 118, 204, 0.46);
  }

  .generation-loader__stage.is-changing {
    animation: generationStageIn 420ms ease both;
  }

  .generation-loader__email-note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    width: min(100%, 520px);
    margin: 28px auto 0;
    padding: 15px 17px;
    border: 1px solid rgba(255, 217, 148, 0.28);
    border-radius: 14px;
    background: rgba(18, 8, 39, 0.52);
    color: rgba(255, 240, 250, 0.72);
    font-size: clamp(0.76rem, 2vw, 0.86rem);
    line-height: 1.45;
    text-align: left;
  }

  .generation-loader__email-note strong,
  .generation-loader__email-note span:not(.generation-loader__email-icon) {
    display: block;
  }

  .generation-loader__email-note strong {
    color: #ffe5ad;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .generation-loader__email-icon {
    color: #ffd777;
    font-size: 1.15rem;
    line-height: 1.1;
    text-shadow: 0 0 14px rgba(255, 215, 119, 0.8);
  }

  .generation-loader__particles {
    inset: 0;
    z-index: 1;
  }

  .generation-loader__particles span {
    position: absolute;
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffd98d;
    box-shadow: 0 0 12px 3px rgba(255, 177, 112, 0.68);
    opacity: 0;
    animation: generationParticleFloat 7s ease-in-out infinite;
  }

  .generation-loader__particles span:nth-child(1) { top: 18%; left: 12%; animation-delay: -1s; }
  .generation-loader__particles span:nth-child(2) { top: 31%; left: 84%; animation-delay: -4.5s; transform: scale(0.7); }
  .generation-loader__particles span:nth-child(3) { top: 70%; left: 9%; animation-delay: -2.8s; transform: scale(0.85); }
  .generation-loader__particles span:nth-child(4) { top: 78%; left: 91%; animation-delay: -5.8s; }
  .generation-loader__particles span:nth-child(5) { top: 12%; left: 69%; animation-delay: -3.4s; transform: scale(0.55); }
  .generation-loader__particles span:nth-child(6) { top: 52%; left: 4%; animation-delay: -6.2s; transform: scale(0.6); }
  .generation-loader__particles span:nth-child(7) { top: 88%; left: 27%; animation-delay: -1.8s; transform: scale(0.7); }
  .generation-loader__particles span:nth-child(8) { top: 42%; left: 96%; animation-delay: -3.8s; transform: scale(0.55); }
  .generation-loader__particles span:nth-child(9) { top: 22%; left: 41%; animation-delay: -5.2s; transform: scale(0.5); }
  .generation-loader__particles span:nth-child(10) { top: 62%; left: 78%; animation-delay: -2.2s; transform: scale(0.65); }
  .generation-loader__particles span:nth-child(11) { top: 84%; left: 62%; animation-delay: -4.1s; transform: scale(0.45); }
  .generation-loader__particles span:nth-child(12) { top: 8%; left: 24%; animation-delay: -6.8s; transform: scale(0.6); }

  .generation-loader.is-leaving {
    animation: generationLoaderExit 550ms ease forwards;
    pointer-events: none;
  }

  @keyframes generationAmbientShift {
    from { transform: translate3d(-3%, -2%, 0) rotate(0deg) scale(1); }
    to { transform: translate3d(4%, 3%, 0) rotate(14deg) scale(1.08); }
  }

  @keyframes generationViPulse {
    0%, 100% { opacity: 0.12; transform: translate(-50%, -50%) rotate(-8deg) scale(0.98); }
    50% { opacity: 0.2; transform: translate(-50%, -50%) rotate(-5deg) scale(1.03); }
  }

  @keyframes generationParticleFloat {
    0%, 100% { opacity: 0; transform: translate3d(0, 12px, 0) scale(0.7); }
    20%, 72% { opacity: 0.78; }
    50% { opacity: 0.34; transform: translate3d(8px, -18px, 0) scale(1); }
  }

  @keyframes generationStageIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes generationLoaderExit {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0; transform: scale(0.985); }
  }

  @media (max-width: 640px) {
    .result-shell {
      align-items: flex-start;
      padding: 24px 12px;
    }

    .result-card {
      padding: 18px;
      border-radius: 22px;
    }

    .generation-loader {
      min-height: clamp(540px, 78dvh, 760px);
      min-height: clamp(540px, 78dvh, calc(100dvh - 32px));
      padding-inline: 16px;
      border-radius: 18px;
    }

    .generation-loader__vi {
      font-size: clamp(10rem, 54vw, 16rem);
    }

    .generation-loader__email-note {
      margin-top: 24px;
      padding: 13px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .generation-loader__wash,
    .generation-loader__vi,
    .generation-loader__particles span,
    .generation-loader__stage.is-changing {
      animation: none !important;
    }

    .generation-loader__progress-bar {
      transition: none;
    }

    .generation-loader.is-leaving {
      animation: none;
      opacity: 0;
    }
  }
  .completed-content[hidden] {
